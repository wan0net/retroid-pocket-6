# Committed, non-secret RP6 identity policy. Extended regular expressions.
# The match is evaluated against model, device, product and build display props.
EXPECTED_IDENTITY_REGEX='(^|[._ -])(RP6|Retroid[ _-]*Pocket[ _-]*6)($|[._ -])'
EXPECTED_ABI_REGEX='^arm64-v8a$'
MIN_ANDROID_API=33

# Device-side base directories. These contain no ROMs, BIOS, keys or credentials.
DEVICE_PROJECT_DIR='/sdcard/Download/retroid-pocket-6'
DEVICE_ROMS_DIR='/sdcard/ROMs'
DEVICE_BIOS_DIR='/sdcard/BIOS'
